---
/**
 * Event Card Component
 *
 * Displays an event preview card with date badge, title,
 * time, location, and category.
 *
 * Props:
 * @param {string} title - Event title
 * @param {string} description - Event description
 * @param {string} featuredImage - Card image URL
 * @param {string} slug - Event URL slug
 * @param {string} category - Event category
 * @param {Date} date - Event date
 * @param {string} startTime - Event start time
 * @param {string} endTime - Event end time (optional)
 * @param {string} location - Event location
 * @param {string} link - External link for tickets/registration (optional)
 */

import { Image } from 'astro:assets';

export interface Props {
  title: string;
  description: string;
  featuredImage: string;
  slug: string;
  category: string;
  date: Date;
  startTime: string;
  endTime?: string;
  location: string;
  link?: string;
}

const {
  title,
  description,
  featuredImage,
  slug,
  category,
  date,
  startTime,
  endTime,
  location,
  link,
} = Astro.props;

const eventUrl = `/events/${slug}`;

// Format date parts for the date badge
const day = date.getDate();
const month = new Intl.DateTimeFormat('en-US', { month: 'short' }).format(date);
const year = date.getFullYear();

// Format time display
const timeDisplay = endTime ? `${startTime} - ${endTime}` : startTime;
---

<article class="group bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 border border-neutral-200 hover:border-primary-400">
  <!-- Featured Image with Date Badge -->
  <a href={eventUrl} class="block relative overflow-hidden aspect-[16/9]">
    <Image
      src={featuredImage}
      alt={title}
      width={800}
      height={450}
      format="webp"
      quality={85}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
    <!-- Date Badge -->
    <div class="absolute top-4 left-4 bg-white rounded-lg shadow-lg p-2 text-center min-w-[60px]">
      <div class="text-2xl font-bold text-primary-600 leading-none">{day}</div>
      <div class="text-xs font-semibold text-neutral-600 uppercase">{month}</div>
    </div>
    <!-- Category Badge -->
    <div class="absolute top-4 right-4">
      <span class="inline-block bg-primary-600 text-white px-3 py-1 rounded-full text-xs font-semibold">
        {category}
      </span>
    </div>
  </a>

  <!-- Card Content -->
  <div class="p-6">
    <!-- Title -->
    <h3 class="text-xl md:text-2xl font-bold text-neutral-900 mb-3 line-clamp-2">
      <a href={eventUrl} class="hover:text-primary-600 transition-colors">
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-neutral-600 mb-4 line-clamp-2 leading-relaxed">
      {description}
    </p>

    <!-- Event Details -->
    <div class="space-y-2 text-sm text-neutral-600">
      <!-- Time -->
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-primary-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>{timeDisplay}</span>
      </div>
      <!-- Location -->
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-primary-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="line-clamp-1">{location}</span>
      </div>
    </div>

    <!-- Action Button -->
    <div class="mt-4 pt-4 border-t border-neutral-200">
      <a
        href={eventUrl}
        class="inline-flex items-center text-primary-600 hover:text-primary-700 font-medium transition-colors"
      >
        View Details
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</article>
